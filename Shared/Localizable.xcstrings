    "Look around, save and shop, and what you like shows up here. It's learned on this iPhone and never leaves it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se dig omkring, gem og shop, og hvad du kan lide, vises her. Det læres på denne iPhone og forlader den aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Schauen Sie sich um, speichern Sie und einkaufen Sie, und was Sie mögen, erscheint hier. Es wird auf diesem iPhone gelernt und verlässt es nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mira a tu alrededor, guarda y compra, y lo que te gusta aparece aquí. Se aprende en este iPhone y nunca lo deja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Regardez autour de vous, enregistrez et faites des achats, et ce que vous aimez apparaît ici. Cela est appris sur ce iPhone et ne le quitte jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Guardati intorno, salva e fai acquisti, e quello che ti piace appare qui. Si impara su questo iPhone e non se ne va mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "周りを見て、保存して、買い物をすると、好きなものがここに表示されます。 これはこのiPhoneで学習され、決してそれを離れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "주변을 둘러보고 저장하고 쇼핑하면 좋아하는 것이 여기에 표시됩니다. 이 iPhone에서 학습되어 절대 떠나지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se deg rundt, lagre og handle, og det du liker vil dukke opp her. Det er lært på denne iPhone og forlater den aldri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kijk je om, spaar en winkel, en wat je leuk vindt verschijnt hier. Het wordt geleerd op deze iPhone en verlaat hem nooit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rozejrzyj się, oszczędzaj i kupuj, a to, co lubisz, pojawi się tutaj. Nauczyło się na tym iPhone i nigdy go nie opuszcza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Olhe ao redor, salve e compre, e o que você gosta aparece aqui. Isso é aprendido neste iPhone e nunca o deixa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Olhe à volta, guarde e compre, e o que gosta aparece aqui. É aprendido neste iPhone e nunca o deixa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Titta runt, spara och handla, och det du gillar visas här. Det lär sig på den här iPhone och lämnar den aldrig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Etrafa bakın, kaydedin ve alışveriş yapın ve beğendiğiniz şeyler burada görünür. Bu iPhone'da öğrenilir ve asla onu terk etmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nhìn xung quanh, lưu trữ và mua sắm, và những gì bạn thích sẽ xuất hiện ở đây. Nó được học trên iPhone này và sẽ không bao giờ rời khỏi nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "环顾四周，保存和购物，你喜欢的东西就会出现在这里。它在这个iPhone上学习，永远不会离开它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "環顧四周，儲存和購物，你喜歡的東西就會出現在這裡。它是在這臺iPhone上學習的，永遠不會離開它。"
          }
        }
      }
    },
