        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Logga in för att behålla dina gilla-markeringar, sökningar och köphistorik över enheter. Du kan fortsätta handla som gäst."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beğenilerinizi, aramalarınızı ve ödeme geçmişinizi cihazlar arasında tutmak için oturum açın. Misafir olarak alışveriş yapmaya devam edebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Đăng nhập để giữ lại lượt thích, tìm kiếm và lịch sử thanh toán của bạn trên tất cả các thiết bị. Bạn có thể tiếp tục mua sắm với tư cách là khách mời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "登录以在各个设备上保存您的喜欢、搜索和结账历史记录。您可以作为访客继续购物。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "登入以在所有裝置上保留您的喜歡、搜尋和結帳歷史記錄。您可以作為訪客繼續購物。"
          }
        }
      }
    },
    "Sign in to keep your lists, orders and history across devices." : {
