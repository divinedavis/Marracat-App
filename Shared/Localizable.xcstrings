    "Sent before you used Marracat on this phone, so it can't be opened here." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Det blev sendt, før du brugte Marracat på denne telefon, så det kan ikke åbnes her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es wurde vor Ihrem Einsatz von Marracat auf diesem Telefon gesendet, daher kann es hier nicht geöffnet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envío antes de que usaras Marracat en este teléfono, por lo que no se puede abrir aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envoyé avant que vous n'utilisiez Marracat sur ce téléphone, donc il ne peut pas être ouvert ici."
