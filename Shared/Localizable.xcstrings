    "Your styles, interests, sizes and price ranges will be forgotten. Saved items and orders stay." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dine stilarter, interesser, størrelser og prisklasser vil blive glemt. Gemte varer og ordrer forbliver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ihre Stile, Interessen, Größen und Preisbereiche werden vergessen. Speicherte Artikel und Bestellungen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sus estilos, intereses, tallas y rangos de precios serán olvidados. Los artículos y pedidos guardados se mantendrán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vos styles, vos intérêts, vos tailles et vos gammes de prix seront oubliés. Les articles et les commandes enregistrés restent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I tuoi stili, interessi, taglie e fasce di prezzo saranno dimenticati. Gli articoli e gli ordini salvati rimarranno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "あなたのスタイル、興味、サイズ、価格帯は忘れられます。保存されたアイテムと注文は残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "당신의 스타일, 관심사, 사이즈 및 가격 범위는 잊혀질 것입니다. 저장된 항목과 주문은 그대로 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dine stiler, interesser, størrelser og prisklasser vil bli glemt. Lagrede varer og bestillinger forblir."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uw stijlen, interesses, maten en prijsklassen zullen worden vergeten. Opgeslagen items en bestellingen blijven behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Twoje style, zainteresowania, rozmiary i przedziały cenowe zostaną zapomniane. Zapisane przedmioty i zamówienia pozostają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seus estilos, interesses, tamanhos e faixas de preços serão esquecidos. Os itens e pedidos salvos permanecerão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os seus estilos, interesses, tamanhos e faixas de preço serão esquecidos. Os artigos e encomendas guardados permanecerão."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dina stilar, intressen, storlekar och prisklasser kommer att glömmas bort. Sparade artiklar och beställningar kommer att finnas kvar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stilleriniz, ilgi alanlarınız, bedenleriniz ve fiyat aralıklarınız unutulacak. Kaydedilen ürünler ve siparişler kalacak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Các kiểu dáng, sở thích, kích cỡ và phạm vi giá cả của bạn sẽ bị quên đi. Các mặt hàng và đơn đặt hàng đã lưu sẽ được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
