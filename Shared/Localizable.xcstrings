    "Tap “Add to List” on any item to save it here, so it's easy to come back to." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tryk på \"Tilføj til liste\" på ethvert element for at gemme det her, så du nemt kan vende tilbage til det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tippen Sie auf \"Zur Liste hinzufügen\" für jedes Element, um es hier zu speichern, damit Sie leicht darauf zurückkommen können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toca \"Añadir a la lista\" en cualquier elemento para guardarlo aquí, para que sea fácil volver a él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Appuyez sur \"Ajouter à la liste\" sur n'importe quel élément pour l'enregistrer ici, afin de pouvoir y revenir facilement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tocca \"Aggiungi alla lista\" su qualsiasi elemento per salvarlo qui, in modo da poterci tornare facilmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "任意の項目で「リストに追加」をタップしてここに保存すると、簡単に戻ることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "여기에 저장하기 위해 어떤 항목에도 \"목록에 추가\"를 탭하여 쉽게 다시 방문할 수 있도록 하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trykk på \"Legg til i liste\" for å lagre et element her, slik at du enkelt kan komme tilbake til det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tik op \"Toevoegen aan lijst\" op elk item om het hier op te slaan, zodat je er gemakkelijk weer terug kunt komen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dotknij \"Dodaj do listy\" na dowolnym elemencie, aby zapisać go tutaj, aby łatwo było do niego wrócić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toque em \"Adicionar à Lista\" em qualquer item para salvá-lo aqui, para que seja fácil voltar a ele."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toque em \"Adicionar à Lista\" em qualquer item para o guardar aqui, para que seja fácil voltar a ele."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tryck på \"Lägg till i lista\" för att spara varje objekt här, så att du enkelt kan komma tillbaka till det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Buraya kaydetmek için herhangi bir öğede \"Listeye Ekle\"ye dokunun, böylece geri dönmek kolaydır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nhấn vào \"Thêm vào danh sách\" trên bất kỳ mục nào để lưu nó ở đây, vì vậy bạn có thể dễ dàng quay lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在任何项目上轻点“添加到列表”，即可将其保存到此处，以便随时查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在任何專案上點選「新增到列表」，將其儲存在此處，以便方便後續使用。"
          }
        }
      }
    },
    "Tap “Add to List” on any item to save it here." : {
