        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie zobaczycie swoich komentarzy, profili ani udostępnień, a każda przyjaźń się skończy. Możesz je odblokować z zakładki Ty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Você não verá os comentários, perfis ou compartilhamentos um do outro, e qualquer amizade termina. Você pode desbloqueá-los na guia Você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Não irão ver os comentários, perfis ou partilhas um do outro e qualquer amizade termina. Podem desbloquear-os na guia \"Você\"."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ni kommer inte att se varandras kommentarer, profiler eller delningar, och vänskapen kommer att ta slut. Ni kan avblockera dem från fliken \"Du\"."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Herbirinizin yorumlarını, profillerini veya paylaşımlarını göremeyeceksiniz ve herhangi bir arkadaşlık sona erecektir. Bunları \"Sizin\" sekmesinden engellemeyi kaldırabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bạn sẽ không thể xem các bình luận, hồ sơ hoặc chia sẻ của nhau và bất kỳ mối quan hệ bạn bè nào cũng sẽ kết thúc. Bạn có thể gỡ chặn chúng từ tab Bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "您将无法看到对方的评论、个人资料或分享，任何友谊都将结束。您可以从“您”选项卡中解除对他们的封锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "您將無法看到彼此的評論、個人資料或分享，任何友誼都將結束。您可以從「您」選項卡中解除對它們的遮蔽。"
          }
        }
      }
    },
