    "The badge covers hair care, skincare, makeup, face and body washes, and candles whose brands publish what's in them." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mærket dækker hårpleje, hudpleje, makeup, ansigts- og kropsvaske samt stearinlys, hvis mærker offentliggør indholdet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Badge deckt Haarpflege, Hautpflege, Make-up, Gesicht- und Körperwaschen sowie Kerzen ab, deren Marken veröffentlichen, was sie enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El distintivo cubre el cuidado del cabello, el cuidado de la piel, el maquillaje, los jabones faciales y corporales y las velas cuyas marcas publican lo que contienen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le badge couvre les soins capillaires, les soins de la peau, le maquillage, les gommages pour le visage et le corps, et les bougies dont les marques publient ce qu'elles contiennent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il badge copre la cura dei capelli, la cura della pelle, il trucco, i lavaggi viso e corpo e le candele le cui marche pubblicano ciò che contengono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このバッジは、ヘアケア、スキンケア、メイクアップ、フェイス＆ボディウォッシュ、ブランドが成分を公表しているキャンドルなどをカバーしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 배지는 헤어 케어, 스킨케어, 메이크업, 페이스 및 바디 워시, 그리고 그 안에 무엇이 들어 있는지 브랜드가 공개하는 촛불을 포함합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merket dekker hårpleie, hudpleie, sminke, ansikts- og kroppsvask og lys hvis merker publiserer hva som er i dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Het badge dekt haarverzorging, huidverzorging, make-up, gezicht- en lichaamswas en kaarsen waarvan de merken publiceren wat erin zit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odznaka obejmuje produkty do pielęgnacji włosów, pielęgnacji skóry, makijażu, mycia twarzy i ciała oraz świece, których marki publikują, co w nich jest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O distintivo cobre cuidados com o cabelo, cuidados com a pele, maquiagem, sabonetes faciais e corporais e velas cujas marcas publicam o que há nelas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O distintivo cobre cuidados com o cabelo, cuidados com a pele, maquilhagem, sabonetes faciais e corporais e velas cujas marcas publicam o que há nelas."
          }
        },
        "sv" : {
          "stringUnit" : {
