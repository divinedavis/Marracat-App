    "Sign in to the same %@ account to confirm. Your Marracat account, saved items, history and synced checkout records will be deleted. This does not cancel orders or delete information held by brands." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Log ind på den samme %@-konto for at bekræfte. Din Marracat-konto, gemte varer, historik og synkroniserede betalingsoptegnelser vil blive slettet. Dette annullerer ikke ordrer eller sletter oplysninger, der holdes af mærker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Melden Sie sich bei demselben %@-Konto an, um die Bestätigung abzuschließen. Ihr Marracat-Konto, gespeicherte Artikel, Ihre Bestandsübersicht und die synchronisierten Bestellaufzeichnungen werden gelöscht. Dies storniert keine Bestellungen oder löscht Informationen, die von Marken gespeichert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inicie sesión en la misma cuenta %@ para confirmar. Su cuenta Marracat, los artículos guardados, el historial y los registros de pago sincronizados se eliminarán. Esto no cancela pedidos ni elimina la información que detienen las marcas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Connectez-vous au même compte %@ pour confirmer. Votre compte Marracat, les articles enregistrés, l'historique et les enregistrements de paiement synchronisés seront supprimés. Cela ne résilie pas les commandes ni ne supprime les informations détenues par les marques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Accedi allo stesso account %@ per confermare. Il tuo account Marracat, gli articoli salvati, la cronologia e i record di pagamento sincronizzati verranno cancellati. Ciò non annulla gli ordini né elimina le informazioni detenute dai marchi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "確認するには、同じ%@アカウントにサインインしてください。Marracatアカウント、保存されたアイテム、履歴、同期されたチェックアウトレコードは削除されます。これは注文のキャンセルやブランドが保持している情報の削除にはなりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "확인하기 위해 동일한 %@ 계정에 로그인하십시오. 귀하의 Marracat 계정, 저장된 항목, 기록 및 동기화된 결제 기록이 삭제됩니다. 이는 주문을 취소하거나 브랜드가 보유한 정보를 삭제하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Logg på samme %@-konto for å bekrefte. Din Marracat-konto, lagrede varer, historikk og synkroniserte handlehistorikk vil bli slettet. Dette kansellerer ikke bestillinger eller sletter informasjon som holdes av merkevarer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Log in op hetzelfde %@-account om te bevestigen. Uw Marracat-account, opgeslagen items, geschiedenis en gesynchroniseerde afrekenrecords worden verwijderd. Dit annuleert geen bestellingen of verwijdert informatie die door merken wordt bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zaloguj się na to samo konto %@, aby potwierdzić. Twoje konto Marracat, zapisane elementy, historia i zsynchronizowane rekordy kasy zostaną usunięte. To nie anuluje zamówień ani nie usuwa informacji posiadanych przez marki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faça login na mesma conta %@ para confirmar. Sua conta Marracat, itens salvos, histórico e registros de checkout sincronizados serão excluídos. Isso não cancela pedidos ou exclui informações mantidas pelas marcas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inicie sessão na mesma conta %@ para confirmar. A sua conta Marracat, artigos guardados, histórico e registos de finalização de compra sincronizados serão eliminados. Isto não cancela encomendas nem elimina informações detidas pelas marcas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Logga in på samma %@-konto för att bekräfta. Ditt Marracat-konto, sparade artiklar, historik och synkroniserade kassorecord kommer att raderas. Detta avbryter inte beställningar eller raderar information som innehas av varumärken."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Onaylamak için aynı %@ hesabına giriş yapın. Marracat hesabınız, kaydedilen öğeler, geçmişiniz ve senkronize edilmiş ödeme kayıtlarınız silinecektir. Bu, siparişleri iptal etmez veya markalar tarafından tutulan bilgileri silmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Đăng nhập vào cùng một tài khoản %@ để xác nhận. Tài khoản Marracat của bạn, các mặt hàng đã lưu, lịch sử và hồ sơ thanh toán đã đồng bộ hóa sẽ bị xóa. Điều này sẽ không hủy đơn đặt hàng hoặc xóa thông tin được giữ bởi các thương hiệu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "登录相同的%@帐户进行确认。您的Marracat帐户、已保存的项目、历史记录和同步的结账记录将被删除。这不会取消订单或删除品牌持有的信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "登入相同的%@帳戶以確認。您的Marracat帳戶、已儲存的物品、歷史記錄和同步的結賬記錄將被刪除。這不會取消訂單或刪除品牌持有的資訊。"
          }
        }
      }
    },
