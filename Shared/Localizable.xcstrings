    "%@'s checkout can't open inside Marracat right now. You can still check out on %@." : {
      "comment" : "Checkout error; the argument is a brand name or its web domain",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@'s kasse kan ikke åbnes inde i Marracat lige nu. Du kan stadig betale på %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Kasse von %1$@ kann im Moment nicht innerhalb von Marracat geöffnet werden. Sie können trotzdem an %2$@ bezahlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@'s checkout can't open inside Marracat right now. You can still check out on %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El pago de %1$@ no se puede abrir dentro de Marracat en este momento. Todavía puedes pagar en %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le paiement de %1$@ ne peut pas s'ouvrir à l'intérieur de Marracat en ce moment. Vous pouvez toujours payer sur %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il pagamento di %1$@ non può essere effettuato all'interno di Marracat in questo momento. Puoi comunque pagare su %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@のチェックアウトは現在Marracat内では開けません。それでも%2$@でチェックアウトできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@의 결제 창구는 현재 Marracat 내부에서 열 수 없습니다. %2$@에서 결제할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kassen til %1$@ kan ikke åpnes inne i Marracat akkurat nå. Du kan fortsatt sjekke ut på %2$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De uitbetaling van %1$@ kan momenteel niet openen in Marracat. Je kunt nog steeds uitbetalen op %2$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sprawa %1$@ nie może się teraz otworzyć wewnątrz Marracat. Nadal możesz sprawdzić na %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
