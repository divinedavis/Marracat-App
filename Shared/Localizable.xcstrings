    "BHA, caramel colour and carrageenan are legal everywhere; we note them." : {
      "comment" : "Quality badge standard sheet: a rule (short title or one line)",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "BHA, karamellfarve og carrageenan er lovlige overalt; vi bemærker dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "BHA, Karamellfarbe und Carrageenan sind überall legal; wir nehmen sie zur Kenntnis."
