        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "시리톨, 포도, 양파, 마늘, 초콜릿 또는 마카다미아가 들어 있지 않습니다. 고양이를 위한 프로필렌 글리콜도 들어 있지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ingen xylitol, druer, løk, hvitløk, sjokolade eller macadamia; ingen propylenglykol for katter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geen xylitol, druiven, ui, knoflook, chocolade of macadamia; geen propyleenglycol voor katten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bez ksylitolu, winogron, cebuli, czosnku, czekolady lub makadamii; bez glikolu propylenowego dla kotów."
          }
        },
        "pt-BR" : {
