    "PVC or vinyl must be stated phthalate-free." : {
      "comment" : "Quality badge standard sheet: a rule (short title or one line)",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "PVC eller vinyl skal angives som phthalatfri."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "PVC oder Vinyl müssen phthalatfrei angegeben werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El PVC o el vinilo deben indicar que no contienen ftalatos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
