    "You won't see each other's comments, profiles or shares, and any friendship ends." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I vil ikke se hinandens kommentarer, profiler eller delinger, og enhver venskab vil ophøre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sie werden sich keine Kommentare, Profile oder Shares des anderen ansehen können, und jede Freundschaft endet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No verán los comentarios, perfiles o compartidos del otro, y cualquier amistad termina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous ne verrez pas les commentaires, les profils ou les partages de l'autre, et toute amitié prend fin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Non vedrete i commenti, i profili o le condivisioni l'uno dell'altro e ogni amicizia finisce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "お互いのコメント、プロフィール、共有は表示されず、友情は終わりを迎えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "당신은 서로의 댓글, 프로필 또는 공유를 볼 수 없으며 모든 우정은 끝납니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du vil ikke se hverandres kommentarer, profiler eller delinger, og vennskapet vil opphøre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je zult elkaars reacties, profielen of delen niet zien, en elke vriendschap eindigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie zobaczycie swoich komentarzy, profili ani udostępnień, a każda przyjaźń się skończy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Você não verá os comentários, perfis ou compartilhamentos um do outro, e qualquer amizade termina."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Não irão ver os comentários, perfis ou partilhas um do outro e qualquer amizade termina."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ni kommer inte att se varandras kommentarer, profiler eller delningar, och vänskapen kommer att ta slut."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Herbirinizin yorumlarını, profillerini veya paylaşımlarını göremeyeceksiniz ve herhangi bir arkadaşlık sona erecektir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bạn sẽ không thể nhìn thấy các bình luận, hồ sơ hoặc chia sẻ của nhau và bất kỳ tình bạn nào cũng sẽ kết thúc."
