    "Report anything that breaks these rules. Reported posts are hidden right away and reviewed within 24 hours." : {
      "comment" : "Community rule",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anmeld alt, der bryder disse regler. Anmeldte opslag vises ikke med det samme og gennemgås inden for 24 timer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Melden Sie alles, was diese Regeln verletzt. Meldete Beiträge werden sofort verschoben und innerhalb von 24 Stunden überprüft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Denúncialo todo lo que rompa estas reglas. Las publicaciones denunciadas se ocultan inmediatamente y se revisan dentro de las 24 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Signalez tout ce qui viole ces règles. Les publications signalées sont cachées immédiatement et examinées dans les 24 heures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Segnala qualsiasi cosa che violi queste regole. I post segnalati vengono nascosti immediatamente e esaminati entro 24 ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "これらのルールに違反するものは何でも報告してください。報告された投稿はすぐに非表示になり、24時間以内にレビューされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이러한 규칙을 위반하는 모든 것을 보고하십시오. 보고된 게시물은 즉시 숨겨지고 24시간 이내에 검토됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rapporter alt som bryter disse reglene. Rapporterte innlegg blir skjult umiddelbart og gjennomgått innen 24 timer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rapporteer alles dat deze regels schendt. Gerapporteerde berichten worden direct verborgen en binnen 24 uur beoordeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zgłoś wszystko, co łamie te zasady. Zgłoszone posty są natychmiast ukrywane i sprawdzane w ciągu 24 godzin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Denuncie qualquer coisa que viole essas regras. As postagens denunciadas são ocultadas imediatamente e revisadas dentro de 24 horas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Denuncie qualquer coisa que viole estas regras. As publicações denunciadas são ocultadas imediatamente e analisadas dentro de 24 horas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rapportera allt som bryter mot dessa regler. Rapporterade inlägg visas inte direkt och granskas inom 24 timmar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu kuralları ihlal eden her şeyi bildirin. Bildirilen gönderiler hemen gizlenir ve 24 saat içinde incelenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Báo cáo bất kỳ điều gì vi phạm các quy tắc này. Các bài đăng đã được báo cáo sẽ bị ẩn ngay lập tức và được xem xét trong vòng 24 giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "举报任何违反这些规则的内容。举报的帖子将立即隐藏，并在24小时内进行审查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
