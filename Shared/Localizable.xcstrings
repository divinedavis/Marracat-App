            "value" : "O checkout do %1$@ não pode ser aberto dentro do Marracat agora. Você ainda pode fazer o checkout no %2$@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A caixa de pagamento do %1$@ não pode ser aberta dentro do Marracat neste momento. Você ainda pode fazer o pagamento no %2$@."
