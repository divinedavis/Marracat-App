    "Real leather, canvas, jute, raffia, cork, or a named recycled or plant leather." : {
      "comment" : "Quality badge standard sheet: a rule (short title or one line)",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ægte læder, lærred, jute, raffia, kork eller et navngivet genbrugslæder eller plantelæder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
