    "Removes your searches and product-view history. Your saved items and checkout records stay available." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fjerner dine søgninger og produktvisningshistorik. Dine gemte varer og betalingsoptegnelser forbliver tilgængelige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entfernt Ihre Suchanfragen und Produktansichtsgeschichte. Ihre gespeicherten Artikel und Bestellaufzeichnungen bleiben verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elimina sus búsquedas y el historial de vistas de productos. Sus artículos guardados y registros de pago permanecen disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Supprime vos recherches et votre historique de visualisation des produits. Vos articles enregistrés et vos relevés de paiement restent disponibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cancella le tue ricerche e la cronologia delle visualizzazioni dei prodotti. Gli articoli salvati e i registri del checkout rimangono disponibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "検索履歴と製品表示履歴を削除します。保存したアイテムとチェックアウト記録は引き続き使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "검색 및 제품 보기 기록을 제거합니다. 저장된 항목 및 결제 기록은 계속 사용할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fjerner søkene dine og historikken for produktvisninger. Dine lagrede elementer og handlehistorikken din forblir tilgjengelige."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verwijst uw zoekopdrachten en productweergavegeschiedenis. Uw opgeslagen items en afrekenrecords blijven beschikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usuwa wyszukiwanie i historię wyświetleń produktu. Twoje zapisane przedmioty i zapisy kasowe pozostają dostępne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Remove suas pesquisas e histórico de visualização de produtos. Seus itens salvos e registros de checkout permanecem disponíveis."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Remove as suas pesquisas e histórico de visualizações de produtos. Os seus artigos guardados e registos de finalização da compra permanecem disponíveis."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tar bort dina sökningar och din produktvisningshistorik. Dina sparade artiklar och köphistorik förblir tillgängliga."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arama geçmişinizi ve ürün görünüm geçmişinizi kaldırır. Kaydedilen öğeleriniz ve ödeme kayıtlarınız mevcuttur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Xóa các tìm kiếm và lịch sử xem sản phẩm của bạn. Các mục đã lưu và hồ sơ thanh toán của bạn vẫn có sẵn."
