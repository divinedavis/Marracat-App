          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Neem contact op met %@ voor een terugbetaling of een nieuwe verzending. Retouren en verzendproblemen zijn de taak van het merk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skontaktuj się z %@ w sprawie zwrotu pieniędzy lub nowej przesyłki. Zwroty i problemy z wysyłką należy do marki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entre em contato com a %@ sobre um reembolso ou uma nova remessa. Devoluções e problemas de envio são responsabilidade da marca."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Contacte a %@ sobre um reembolso ou uma nova remessa. Problemas de devoluções e envio são responsabilidade da marca."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kontakta %@ för återbetalning eller en ny leverans. Returer och fraktproblem är märket ansvarigt för."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
