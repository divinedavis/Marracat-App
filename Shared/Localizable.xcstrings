    "Orders are placed on each brand's own store. Shipping updates and returns come from the brand." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bestillinger foretages på hver enkelt brands egen butik. Forsendelsesopdateringer og returneringer kommer fra brandet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bestellungen werden in den eigenen Geschäften der jeweiligen Marke aufgegeben. Versandaktualisierungen und Rücksendungen stammen von der Marke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los pedidos se realizan en la propia tienda de cada marca. Las actualizaciones de envío y devoluciones provienen de la marca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les commandes sont passées dans la boutique propre de chaque marque. Les mises à jour et les retours d'expédition proviennent de la marque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gli ordini vengono effettuati nel negozio di ciascuna marca. Gli aggiornamenti sulla spedizione e i resi provengono dalla marca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "注文は各ブランドの独自のストアで完了します。配送の更新と返品はブランドから行われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "주문은 각 브랜드의 자체 스토어에서 이루어집니다. 배송 업데이트와 반품은 브랜드에서 제공합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bestillinger legges inn i hver enkelt merkevare sin egen butikk. Oppdateringer om frakt og retur kommer fra merkevaren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bestellingen worden geplaatst in de eigen winkel van elk merk. Verzendupdates en retouren komen van het merk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zamówienia są składane we własnym sklepie każdej marki. Aktualizacje wysyłki i zwroty pochodzą od marki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os pedidos são feitos na loja própria de cada marca. As atualizações de envio e devoluções vêm da marca."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
