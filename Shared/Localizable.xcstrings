    "Clothing and bedding are cotton, linen, wool, silk or hemp, or certified organic." : {
      "comment" : "Quality badge standard sheet: a rule (short title or one line)",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tøj og sengetøj er lavet af bomuld, linned, uld, silke eller hamp eller er certificeret økologisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kleidung und Bettwäsche bestehen aus Baumwolle, Leinen, Wolle, Seide oder Hanf oder sind zertifiziert biologisch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La ropa y la ropa de cama son de algodón, lino, lana, seda o cáñamo, o orgánica certificada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les vêtements et les draps sont en coton, lin, laine, soie ou chanvre, ou certifiés biologiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I vestiti e i lenzuola sono in cotone, lino, lana, seta o canapa, o certificati biologici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "衣類と寝具は、綿、リネン、ウール、シルク、ヘプン、または認証されたオーガニック素材を使用しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "의류와 침구는 면, 린넨, 울, 실크 또는 대마, 또는 인증된 유기농 제품입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kles- og sengetøy er laget av bomull, lin, ull, silke eller hamp, eller er sertifisert økologisk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kleding en beddengoed zijn gemaakt van katoen, linnen, wol, zijde of hennep, of gecertificeerd biologisch."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odzież i pościel to bawełna, len, wełna, jedwab lub konopie, lub certyfikowane organiczne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Roupas e roupas de cama são de algodão, linho, lã, seda ou cânhamo, ou orgânicos certificados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As roupas e os artigos de cama são de algodão, linho, lã, seda ou cânhamo, ou certificados orgânicos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kläder och sängkläder är i bomull, linne, ull, siden eller hampa eller certifierade ekologiska."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kıyafetler ve yatak takımları pamuk, keten, yün, ipek veya kenevir veya sertifikalı organiktir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quần áo và đồ ngủ được làm từ bông, vải lanh, len, lụa hoặc cây gai dầu, hoặc hữu cơ được chứng nhận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "服装和床上用品是棉、亚麻、羊毛、丝绸或大麻，或经过认证的有机产品。"
          }
        },
        "zh-Hant" : {
