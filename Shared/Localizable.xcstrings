    "Learned from what you look at, save and buy, on this iPhone only. Start over clears all of it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lær af det, du ser, gemmer og køber, kun på denne iPhone. At starte forfra sletter alt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lernen Sie aus dem, was Sie sich ansehen, speichern und kaufen, nur auf diesem iPhone. Von vorne zu beginnen löscht alles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aprendí de lo que ves, guardas y compras, solo en este iPhone. Reiniciar borra todo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apprenez de ce que vous regardez, économisez et achetez, uniquement sur ce iPhone. Commencer à nouveau efface tout cela."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Impara da ciò che guardi, salvi e acquisti, solo su questo iPhone. Riprendere da capo lo cancella tutto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このiPhoneで、あなたが見て、保存し、購入したことを学びました。やり直すとすべてクリアされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 iPhone에서만 당신이 보고, 저장하고, 구매하는 것에 대해 배웠습니다. 처음부터 다시 시작하면 모든 것을 지웁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jeg har lært hva jeg bør kjøpe, spare og investere i, spesielt med tanke på denne iPhone. Å starte på nytt vil fjerne alt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leer van wat je bekijkt, opslaat en koopt, alleen op deze iPhone. Herbeginnen wissen alles."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nauczyłem się z tego, na co patrzysz, oszczędzasz i kupujesz, tylko w tym iPhone. Zacznij od nowa, czyści to wszystko."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aprendi com o que você olha, salva e compra, apenas neste iPhone. Começar de novo limpa tudo isso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aprenda com o que você vê, salva e compra, apenas neste iPhone. Reiniciar limpa tudo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lär dig av vad du tittar på, sparar och köper, bara för denna iPhone. Att börja om rensar allt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sadece bu iPhone'da baktığınız, kaydettiğiniz ve satın aldığınız şeylerden öğrendiniz. Baştan başlamak her şeyi temizler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Học hỏi từ những gì bạn nhìn thấy, lưu trữ và mua, chỉ trên iPhone này. Bắt đầu lại sẽ xóa bỏ tất cả chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "仅在此iPhone上，从您查看、保存和购买的内容中学习。重新开始将全部内容清除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "僅僅從您在這個iPhone上檢視、儲存和購買的內容中學習。重新開始將清除所有內容。"
          }
        }
      }
    },
    "Leather tanned without chrome, so no chromium VI." : {
