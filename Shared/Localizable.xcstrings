    "No xylitol, grapes, onion, garlic, chocolate or macadamia; no propylene glycol for cats." : {
      "comment" : "Quality badge standard sheet: a rule (short title or one line)",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ingen xylitol, druer, løg, hvidløg, chokolade eller macadamia; ingen propylenglycol til katte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Keine Xylit, Trauben, Zwiebeln, Knoblauch, Schokolade oder Macadamia; kein Propylenglykol für Katzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sin xilitol, uvas, cebolla, ajo, chocolate ni macadamia; sin propilenglicol para gatos."
