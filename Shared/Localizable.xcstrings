    "Discover brands, explore categories, and keep your favorite finds together with Marracat." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opdag mærker, udforsk kategorier og gem dine yndlingsfund sammen med Marracat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entdecken Sie Marken, erkunden Sie Kategorien und behalten Sie Ihre Lieblingsfunde mit Marracat zusammen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Descubre marcas, explora categorías y guarda tus hallazgos favoritos juntos con Marracat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Découvrez des marques, explorez des catégories et gardez vos trouvailles préférées ensemble avec Marracat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scopri marchi, esplora categorie e tieni insieme i tuoi ritrovamenti preferiti con Marracat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ブランドを発見し、カテゴリーを探索し、Marracatと一緒にお気に入りのアイテムをまとめましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "브랜드를 발견하고, 카테고리를 탐색하고, Marracat와 함께 좋아하는 것을 함께 보관하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oppdag merker, utforsk kategorier og organiser dine favorittfunn med Marracat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ontdek merken, verkennen categorieën en houd je favoriete vondsten bij elkaar met Marracat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odkrywaj marki, eksploruj kategorie i trzymaj swoje ulubione znaleziska razem z Marracat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Descubra marcas, explore categorias e mantenha suas descobertas favoritas juntas com o Marracat."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Descubra marcas, explore categorias e mantenha as suas descobertas favoritas juntas com a Marracat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Med Marracat kan du upptäcka varumärken, utforska kategorier och hålla dina favoritfynd organiserade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Markaları keşfedin, kategorileri keşfedin ve Marracat ile en sevdiğiniz bulgularınızı bir arada tutun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Khám phá các thương hiệu, khám phá các danh mục và giữ những phát hiện yêu thích của bạn cùng nhau với Marracat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "使用Marracat发现品牌，探索类别，并将您最喜欢的发现一起保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "使用Marracat發現品牌、探索類別，並將您最喜歡的發現一起保留。"
          }
        }
      }
    },
