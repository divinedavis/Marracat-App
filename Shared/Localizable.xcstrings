    "Restock alerts are for Marracat accounts. Sign in, then tap “Notify me when it's back” on a sold-out item." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tilbageholdelsesbeskeder er kun tilgængelige for Marracat-konti. Log ind, og tryk derefter på \"Giv mig besked, når det er tilbage på lager\", når en vare er udsolgt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Restock-Benachrichtigungen sind für Marracat-Konten. Melden Sie sich an und tippen Sie dann auf \"Ich benachrichtigen, wenn es wieder da ist\", wenn ein ausverkauftes Produkt angezeigt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las alertas de reposición son para cuentas Marracat. Inicie sesión y luego toque \"Notificarme cuando vuelva a estar disponible\" en un artículo agotado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les alertes de réapprovisionnement sont destinées aux comptes Marracat. Connectez-vous, puis appuyez sur \"M'informer quand il sera de retour\" sur un article épuisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gli avvisi di rifornimento sono per gli account Marracat. Accedi, quindi tocca \"Notificami quando torna disponibile\" su un articolo esaurito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "再入荷アラートはMarracatアカウントを対象としています。ログインしたら、売り切れアイテムで「再入荷したら通知する」をタップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "재고 재입고 알림은 Marracat 계정용입니다. 로그인한 다음 매진된 품목에서 \"재입고 시 알려주세요\"를 탭합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Restocking-varsler gjelder Marracat-kontoer. Logg inn og trykk deretter på \"Varsle meg når det er tilbake\" for en utsolgt vare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hervoorraadmeldingen zijn voor Marracat-accounts. Log in en tik vervolgens op \"Laat me weten wanneer het terug is\" op een uitverkocht item."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alerty o uzupełnieniu zapasów są dla kont Marracat. Zaloguj się, a następnie dotknij „Powiadom mnie, gdy wróci” na wyprzedanym produkcie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os alertas de reposição são para contas Marracat. Faça login e, em seguida, toque em \"Notifique-me quando voltar a estar disponível\" em um item esgotado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os alertas de reposição são para contas Marracat. Inicie sessão e, em seguida, toque em \"Notificar-me quando voltar a estar disponível\" num artigo esgotado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tillgänglighetsskyddsmeddelanden gäller för Marracat-konton. Logga in och tryck sedan på \"Meddela mig när den är tillbaka\" för en slutsåld vara."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yenilenme uyarıları Marracat hesapları içindir. Giriş yapın, ardından tükenmiş bir ürünün üzerine \"Tekrar geldiğinde bana bildir\" seçeneğine dokunun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Các cảnh báo bổ sung hàng tồn kho dành cho tài khoản Marracat. Đăng nhập, sau đó nhấn vào \"Thông báo cho tôi khi nó trở lại\" trên một mặt hàng đã bán hết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "补货提醒适用于Marracat帐户。登录后，在售罄商品上轻点“当它恢复时通知我”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "補貨提醒適用於Marracat帳戶。請登入，然後在售罄商品上點選「當它回來時通知我」。"
          }
        }
      }
    },
