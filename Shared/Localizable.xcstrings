    "Posts that break them are removed, and accounts that keep breaking them are banned." : {
      "comment" : "Community rule",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Indlæg, der bryder disse regler, fjernes, og konti, der fortsat bryder dem, bliver udelukket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beiträge, die sie brechen, werden entfernt, und Konten, die sie weiterhin brechen, werden gesperrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los publicaciones que los rompan se eliminan, y las cuentas que continúan rompiéndolos son baneadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les publications qui les cassent sont supprimées, et les comptes qui continuent à les casser sont bannis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I post che li rompono vengono rimossi e gli account che continuano a romperli vengono bannati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "それらを破る投稿は削除され、それらを破り続けるアカウントは禁止されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "그것들을 깨뜨리는 게시물은 삭제되고, 그것들을 계속 깨뜨리는 계정은 차단됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Innlegg som bryter reglene blir fjernet, og kontoer som fortsetter å bryte dem, blir utestengt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Berichten die ze breken worden verwijderd, en accounts die ze blijven breken worden gebannen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Posty, które je łamią, są usuwane, a konta, które ciągle je łamią, są blokowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Postagens que os quebram são removidas e contas que continuam quebrando são banidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As publicações que os quebram são removidas e as contas que continuam a quebrá-los são banidas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inlägg som bryter mot dessa regler tas bort, och konton som fortsätter att bryta mot dem blir avstängda."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bunları bozan gönderiler kaldırılır ve bunları sürekli bozan hesaplar yasaklanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Các bài đăng làm hỏng chúng sẽ bị xóa, và các tài khoản tiếp tục làm hỏng chúng sẽ bị cấm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "违反这些规则的帖子将被删除，而继续违反规则的帐户将被禁止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "違反這些規則的帖子將被刪除，而持續違反這些規則的帳戶將被禁止。"
          }
        }
      }
    },
