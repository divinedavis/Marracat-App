    "Check Track package below. If it hasn't moved, contact %@ about where your order is." : {
      "comment" : "Delivery problem advice; the argument is a brand name",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se sporingspakken nedenfor. Hvis den ikke er flyttet, bedes du kontakte %@ for at få oplysninger om din ordre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Überprüfen Sie das unten stehende Sendungsverfolgungspaket. Wenn es sich nicht bewegt hat, wenden Sie sich bitte an %@, um zu erfahren, wo Ihre Bestellung sich befindet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compruebe el paquete de seguimiento a continuación. Si no ha movido, póngase en contacto con %@ sobre dónde está su pedido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vérifiez le colis de suivi ci-dessous. Si il n'a pas bougé, contactez %@ pour savoir où se trouve votre commande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Controlla il pacchetto di tracciamento qui sotto. Se non si è spostato, contatta %@ per sapere dove si trova il tuo ordine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "以下のトラックパッケージを確認してください。もしそれが動いていなければ、注文の場所について%@に連絡してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
