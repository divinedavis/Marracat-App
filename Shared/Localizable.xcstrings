    "Cotton, linen, hemp, wool, cashmere, alpaca or silk; up to 10% stretch is fine." : {
      "comment" : "Quality badge standard sheet: a rule (short title or one line)",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bomuld, linned, hamp, uld, cashmere, alpaka eller silke; op til 10 % stræk er fint."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baumwolle, Leinen, Hanf, Wolle, Kaschmir, Alpaka oder Seide; bis zu 10 % Elastizität ist in Ordnung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Algodón, lino, cáñamo, lana, cachemira, alpaca o seda; hasta un 10 % de elasticidad está bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coton, lin, chanvre, laine, cachemire, alpaga ou soie ; jusqu'à 10 % de souplesse est acceptable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cotone, lino, canapa, lana, cashmere, alpaca o seta; fino al 10% di elasticità va bene."
          }
        },
        "ja" : {
