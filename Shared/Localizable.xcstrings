    "You can browse and shop without a Marracat account. Guest activity, your cart and the checkout details you enter are stored on this device." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kan browse og shoppe uden en Marracat-konto. Gæsteaktivitet, din kurv og de betalingsoplysninger, du indtaster, gemmes på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sie können ohne Marracat-Konto surfen und einkaufen. Gästeaktivitäten, Ihr Warenkorb und die beim Checkout eingegebenen Details werden auf diesem Gerät gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puede navegar y comprar sin una cuenta Marracat. La actividad de invitado, su carrito y los detalles de pago que ingrese se almacenan en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous pouvez parcourir et faire des achats sans avoir de compte Marracat. L'activité des invités, votre panier et les détails de paiement que vous entrez sont stockés sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puoi navigare e fare acquisti senza un account Marracat. L'attività degli ospiti, il tuo carrello e i dettagli del pagamento che inserisci vengono memorizzati su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Marracatアカウントなしで閲覧やショッピングを行うことができます。ゲストアクティビティ、カート、入力したチェックアウト詳細が、このデバイスに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Marracat 계정이 없어도 탐색하고 쇼핑할 수 있습니다. 게스트 활동, 장바구니 및 입력한 결제 세부 정보는 이 기기에 저장됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kan bla gjennom og handle uten en Marracat-konto. Gjestaktivitet, handlekurven din og detaljene du oppgir ved betaling lagres på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "U kunt bladeren en winkelen zonder een Marracat-account. Gastactiviteit, uw winkelwagen en de betalingsgegevens die u invoert, worden op dit apparaat opgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Możesz przeglądać i robić zakupy bez konta Marracat. Aktywność gościa, Twój koszyk i wprowadzone dane do kasy są przechowywane na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Você pode navegar e fazer compras sem uma conta Marracat. A atividade de visitante, seu carrinho e os detalhes do checkout que você inserir são armazenados neste dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pode navegar e comprar sem uma conta Marracat. A atividade de visitante, o seu carrinho e os detalhes do checkout que introduz são armazenados neste dispositivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kan surfa och handla utan ett Marracat-konto. Gästaktivitet, din varukorg och de uppgifter du anger vid kassan lagras på den här enheten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bir Marracat hesabı olmadan gezinebilir ve alışveriş yapabilirsiniz. Misafir etkinliği, sepetiniz ve girdiğiniz ödeme detayları bu cihazda saklanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bạn có thể duyệt web và mua sắm mà không cần tài khoản Marracat. Hoạt động của khách mời, giỏ hàng của bạn và các chi tiết thanh toán bạn nhập được lưu trữ trên thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "您无需Marracat帐户即可浏览和购物。访客活动、您的购物车和您输入的结账详细信息将存储在此设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "您無需Marracat帳戶即可瀏覽和購物。訪客活動、您的購物車和您輸入的結賬詳細資訊將儲存在此裝置上。"
          }
        }
      }
    },
    "You can pick faster delivery at checkout." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ved kassen kan du vælge hurtig levering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sie können bei der Kasse eine schnellere Lieferung wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puedes elegir la entrega más rápida al finalizar la compra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous pouvez choisir une livraison plus rapide à la caisse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puoi scegliere la consegna più veloce al momento del pagamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "チェックアウト時により速い配達を選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "결제 시 더 빠른 배송을 선택할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kan velge raskere levering ved kassen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je kunt een snellere levering kiezen bij het afrekenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Możesz wybrać szybszą dostawę przy kasie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Você pode escolher entrega mais rápida no momento do pagamento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pode escolher entrega mais rápida no final da compra."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kan välja snabbare leverans i kassan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ödeme sırasında daha hızlı teslimat seçebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bạn có thể chọn giao hàng nhanh hơn khi thanh toán."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "您可以在结账时选择更快的送货。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "您可以在結賬時選擇更快的送貨。"
          }
        }
      }
    },
    "You can report a comment, person or share. A reported comment is hidden until the Marracat team reviews it, aiming to act within 24 hours; we may remove content or stop an account from posting. Reporting a share sends us the product and note your device decrypted." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kan anmelde en kommentar, person eller deling. En anmeldt kommentar vises ikke, før Marracat-teamet gennemgår den og har til hensigt at handle inden for 24 timer. Vi kan fjerne indhold eller forhindre en konto i at poste. Ved at anmelde en deling sender du os produktet og angiver, at din enhed er dekrypteret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sie können einen Kommentar, eine Person oder einen Beitrag melden. Ein gemeldeter Kommentar wird bis zur Überprüfung durch das Marracat-Team versteckt und soll innerhalb von 24 Stunden gehandelt werden; wir können Inhalte entfernen oder eine Kontoveröffentlichung stoppen. Wenn Sie einen Beitrag melden, senden Sie uns das Produkt und geben Sie an, dass Ihr Gerät entschlüsselt wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puedes denunciar un comentario, persona o publicación. Un comentario denunciado se oculta hasta que el equipo de Marracat lo revise, con el objetivo de actuar dentro de las 24 horas; es posible que eliminemos el contenido o detengamos la publicación de una cuenta. Denunciar una publicación nos envía el producto y nos indica que tu dispositivo ha sido descifrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous pouvez signaler un commentaire, une personne ou un partage. Un commentaire signalé est caché jusqu'à ce que l'équipe Marracat le révise, dans le but d'agir dans les 24 heures ; nous pouvons supprimer le contenu ou empêcher un compte de publier. Signaler un partage nous envoie le produit et indique que votre appareil a été déchiffré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puoi segnalare un commento, una persona o una condivisione. Un commento segnalato è nascosto fino a quando il team Marracat non lo esaminerà, con l'obiettivo di agire entro 24 ore; potremmo rimuovere il contenuto o impedire a un account di pubblicare. Segnalare una condivisione ci invia il prodotto e fai sapere che il tuo dispositivo è stato decrittato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "コメント、人物、または共有を報告できます。報告されたコメントは、Marracatチームがレビューするまで非表示になり、24時間以内に対応することを目指しています。コンテンツを削除したり、アカウントの投稿を停止したりする場合があります。共有を報告すると、製品を送信し、デバイスの暗号解読を確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "댓글, 사람 또는 공유를 신고할 수 있습니다. 신고된 댓글은 Marracat 팀이 검토할 때까지 숨겨져 있으며, 24시간 이내에 조치를 취할 것을 목표로 합니다. 콘텐츠가 삭제되거나 계정이 게시를 중단될 수 있습니다. 공유를 신고하면 제품과 기기의 해독이 확인된 내용을 보내드립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kan rapportere en kommentar, person eller deling. En rapportert kommentar blir skjult til Marracat-teamet har gjennomgått den, med mål om å handle innen 24 timer. Vi kan fjerne innhold eller hindre en konto i å poste. Ved å rapportere en deling sender du oss produktet og noterer at enheten din er dekryptert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "U kunt een opmerking, persoon of deelbericht melden. Een gemeld opmerking wordt verborgen totdat het Marracat-team deze beoordeelt en zich tot doel stelt binnen 24 uur te handelen; we kunnen inhoud verwijderen of een account stoppen met het plaatsen van berichten. Het melden van een deelbericht stuurt ons het product en laat u weten dat uw apparaat is gedecodeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Możesz zgłosić komentarz, osobę lub udostępnić. Zgłoszony komentarz jest ukryty, dopóki zespół Marracat go nie przejrzy, dążąc do działania w ciągu 24 godzin; możemy usunąć zawartość lub zatrzymać publikowanie konta. Zgłaszanie udziału wysyła nam produkt i zauważa, że Twoje urządzenie jest odszyfrowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Você pode denunciar um comentário, pessoa ou compartilhamento. Um comentário denunciado é oculto até que a equipe Marracat o revise, visando agir dentro de 24 horas; podemos remover o conteúdo ou impedir que uma conta publique. Denunciar um compartilhamento nos envia o produto e informa que seu dispositivo foi descriptografado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pode denunciar um comentário, pessoa ou partilha. Um comentário denunciado é oculto até que a equipa Marracat o reveja, com o objetivo de agir dentro de 24 horas; podemos remover o conteúdo ou impedir que uma conta publique. Denunciar uma partilha envia-nos o produto e informa-nos que o seu dispositivo foi descifrado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kan rapportera en kommentar, person eller delning. En rapporterad kommentar är dold tills Marracat-teamet granskar den, med målet att agera inom 24 timmar. Vi kan ta bort innehåll eller stoppa ett konto från att publicera. Att rapportera en delning skickar oss produkten och noterar att din enhet har dekrypterats."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bir yorumu, kişiyi veya paylaşımı bildirebilirsiniz. Bildirilen bir yorum, Marracat ekibi tarafından incilene kadar gizlenir ve 24 saat içinde harekete geçmeyi amaçlar; içeriği kaldırabilir veya bir hesabın paylaşım yapmasını durdurabiliriz. Bir paylaşımı bildirmek bize ürünü gönderir ve cihazınızın şifrelenmiş olduğunu not eder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bạn có thể báo cáo một bình luận, người hoặc chia sẻ. Bình luận đã được báo cáo sẽ bị ẩn cho đến khi nhóm Marracat xem xét nó, nhằm mục đích hành động trong vòng 24 giờ; chúng tôi có thể xóa nội dung hoặc ngăn một tài khoản đăng bài. Báo cáo một chia sẻ sẽ gửi cho chúng tôi sản phẩm và ghi chú thiết bị của bạn đã được giải mã."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "您可以报告评论、个人或分享。报告的评论将被隐藏，直到Marracat团队审核，旨在在24小时内采取行动；我们可能会删除内容或阻止帐户发布。报告分享将向我们发送产品，并注明您的设备已解密。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "您可以舉報評論、個人或分享。舉報的評論將被隱藏，直到Marracat團隊審查，旨在在24小時內採取行動；我們可能會刪除內容或阻止帳戶發布。舉報分享將向我們傳送產品，並註明您的裝置已解密。"
          }
        }
      }
    },
    "You check out on each brand's own website, so the brand keeps the sale, the customer relationship, and handles shipping and returns." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du betaler på hver enkelt brands egen hjemmeside, så mærket beholder salget, kundekontakten og håndterer forsendelse og returnering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sie bezahlen auf der eigenen Website der Marke, so dass die Marke den Verkauf, die Kundenbeziehung und die Versand- und Rückgabeabwicklung übernimmt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usted realiza el pago en el propio sitio web de cada marca, por lo que la marca mantiene la venta, la relación con el cliente y se encarga del envío y las devoluciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous effectuez votre paiement sur le site Web de chaque marque, de sorte que la marque conserve la vente, la relation client et gère l'expédition et les retours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Effettui il pagamento sul sito web di ciascuna marca, quindi la marca mantiene la vendita, il rapporto con il cliente e gestisce la spedizione e i resi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "各ブランドのウェブサイトでチェックアウトするため、ブランドが販売、顧客関係、配送、返品を処理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "당신은 각 브랜드의 웹사이트에서 체크아웃하므로 브랜드가 판매, 고객 관계, 배송 및 반품을 처리합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du sjekker ut på hver enkelt merkevare sin egen nettside, så merkevaren beholder salget, kundekontakten og håndterer frakt og retur."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "U checkt uit op de eigen website van elk merk, zodat het merk de verkoop, de klantrelatie behoudt en de verzending en retourzending afhandelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sprawdzasz na własnej stronie internetowej każdej marki, więc marka utrzymuje sprzedaż, relacje z klientem i obsługuje wysyłkę i zwroty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Você faz o checkout no próprio site de cada marca, então a marca mantém a venda, o relacionamento com o cliente e lida com o envio e as devoluções."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Você faz o checkout no próprio site de cada marca, então a marca mantém a venda, o relacionamento com o cliente e trata do envio e devoluções."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du gör din betalning på varumärkets egen webbplats, så att varumärket behåller försäljningen, kundrelationen och hanterar frakt och returer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Her markanın kendi web sitesinden ödeme yaparsınız, böylece marka satışı, müşteri ilişkisini korur ve gönderim ve iadeleri yönetir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bạn kiểm tra trên trang web riêng của từng thương hiệu, vì vậy thương hiệu giữ lại doanh số bán hàng, mối quan hệ với khách hàng và xử lý vận chuyển và trả hàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "您在每个品牌自己的网站上结账，因此品牌保留销售、客户关系，并处理发货和退货。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
