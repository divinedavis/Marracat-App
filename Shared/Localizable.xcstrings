    "Checkout pays one brand at a time on its own checkout, where you can pick faster delivery." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ved kassen betaler Checkout for et mærke ad gangen ved sin egen kasse, hvor du kan vælge hurtig levering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
