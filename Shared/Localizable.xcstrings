    "Less than half polyester, nylon, acrylic or elastane, unless certified." : {
      "comment" : "Quality badge standard sheet: a rule (short title or one line)",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mindst halvdelen polyester, nylon, akryl eller elastan, medmindre det er certificeret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Weniger als die Hälfte Polyester, Nylon, Acryl oder Elastan, es sei denn, sie sind zertifiziert."
