        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Varumärket publicerar en ingredienslista på sin produktida, och märket kontrolleras mot den listan. Vi kan inte bekräfta att listan är komplett. Ingen lista, inget märke."
          }
