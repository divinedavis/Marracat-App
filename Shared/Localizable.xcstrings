    "No additive banned in any country: Red 3, synthetic dyes, titanium dioxide, potassium bromate, BVO and more." : {
      "comment" : "Quality badge standard sheet: a rule (short title or one line)",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ingen tilsætningsstoffer er forbudt i nogen land: Rød 3, syntetiske farvestoffer, titaniumdioxid, kaliumbromat, BVO og mere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Keine Zusatzstoffe sind in irgendeinem Land verboten: Rot 3, synthetische Farbstoffe, Titandioxid, Kaliumbromat, BVO und mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ningún aditivo está prohibido en ningún país: Rojo 3, tintes sintéticos, dióxido de titanio, bromato de potasio, BVO y más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aucun additif n'est interdit dans aucun pays : Rouge 3, colorants synthétiques, dioxyde de titane, bromure de potassium, BVO et plus encore."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nessun additivo è vietato in nessun paese: Red 3, coloranti sintetici, diossido di titanio, bromato di potassio, BVO e altro ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "どの国でも禁止されている添加物はありません。赤3、合成着色料、二酸化チタン、塩酸カリウム、BVOなどです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "모든 국가에서 금지된 첨가제는 없습니다: 레드 3, 합성 염료, 이산화규소, 브로마이트 칼륨, BVO 등이 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ingen tilsetningsstoffer er forbudt i noen land: Rød 3, syntetiske fargestoffer, titandioksid, kaliumbromat, BVO og mer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geen additief verboden in enig land: rood 3, synthetische kleurstoffen, titaniumdioxide, kaliumbromaat, BVO en meer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Żaden dodatek nie jest zabroniony w żadnym kraju: Czerwony 3, syntetyczne barwniki, dwutlenek tytanu, bromian potasu, BVO i inne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nenhum aditivo é proibido em nenhum país: Red 3, corantes sintéticos, dióxido de titânio, bromato de potássio, BVO e muito mais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nenhum aditivo proibido em nenhum país: vermelho 3, corantes sintéticos, dióxido de titânio, bromato de potássio, BVO e muito mais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inga tillsatser är förbjudna i något land: Röd 3, syntetiska färgämnen, titandioxid, kaliumbromat, BVO och mer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hiçbir ülkede yasaklanmış herhangi bir katkı maddesi yoktur: Kırmızı 3, sentetik boyalar, titanyum dioksit, potasyum bromat, BVO ve daha fazlası."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Không có chất phụ gia nào bị cấm ở bất kỳ quốc gia nào: Màu đỏ 3, thuốc nhuộm tổng hợp,二氧化 titan, kali bromat, BVO và nhiều hơn thế nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "任何国家都没有禁止任何添加剂：红3、合成染料、二氧化钛、溴酸钾、BVO等。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "任何國家都禁止使用任何新增劑：紅3色素、合成染料、二氧化鈦、溴酸鉀、BVO等。"
          }
        }
      }
    },
    "No BPA, phthalates, PVC, lead, flame retardants or PFAS, and nothing banned under 3 anywhere." : {
      "comment" : "Quality badge standard sheet: a rule (short title or one line)",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ingen BPA, ftalater, PVC, bly, flammehæmmere eller PFAS, og intet forbudt under 3 overhovedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Keine BPA, Phthalate, PVC, Blei, Flammenhemmstoffe oder PFAS, und nirgendwo ist etwas verboten unter 3."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sin BPA, ftalatos, PVC, plomo, retardantes de llama o PFAS, y nada prohibido bajo 3 en ningún lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pas de BPA, de phtalates, de PVC, de plomb, de retardateurs de flamme ou de PFAS, et rien n'est interdit sous 3 nulle part."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nessun BPA, ftalati, PVC, piombo, retardanti di fiamma o PFAS, e niente vietato sotto 3 da nessuna parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "BPA、フタル酸エステル、PVC、鉛、消火剤、またはPFASを含まず、どこでも3未満で禁止されているものは何もありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "BPA, 프탈레이트, PVC, 납, 방연제 또는 PFAS가 없으며, 어디에서도 3등급으로 금지된 것은 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ingen BPA, ftalat, PVC, bly, flammehemmere eller PFAS, og ingenting er forbudt i noen av 3 land."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geen BPA, ftalaten, PVC, lood, brandvertragers of PFAS, en niks verboden onder 3 overal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bez BPA, ftalanów, PVC, ołowiu, środków zmniejszających palność lub PFAS, a nigdzie nie ma nic zabronionego poniżej 3."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sem BPA, ftalatos, PVC, chumbo, retardantes de chama ou PFAS, e nada proibido em 3 em qualquer lugar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sem BPA, ftalatos, PVC, chumbo, retardantes de chama ou PFAS, e nada proibido em 3 em qualquer lugar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inga BPA, ftalat, PVC, bly, brandsäkrare ämnen eller PFAS, och inget är förbjudet i någon av 3 stater."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "BPA, ftalatlar, PVC, kurşun, yangın geciktiriciler veya PFAS içermez ve hiçbir şey 3 altında yasaklanmamıştır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Không chứa BPA, phthalates, PVC, chì, chất chống cháy hoặc PFAS, và không có gì bị cấm dưới 3 ở bất kỳ đâu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "不含双酚A、邻苯二甲酸酯、PVC、铅、阻燃剂或PFAS，任何地方都不含任何受3号禁令的物质。"
          }
        },
