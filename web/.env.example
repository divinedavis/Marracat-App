NODE_ENV=production
PORT=3107
DATA_DIR=/var/lib/marracat
# Generate with: openssl rand -hex 32. Store only in /etc/marracat/web.env (mode 600).
AUTH_SECRET=
# Google Cloud OAuth web client. Callback: https://marracat.com/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public iOS client ID; used to validate the authorized party of native ID tokens.
GOOGLE_IOS_CLIENT_ID=81643017085-88is0c92d821klsb0u8pdfrin2otg4im.apps.googleusercontent.com
# Apple Services ID. Callback: https://marracat.com/auth/callback/apple
APPLE_IOS_CLIENT_ID=com.divinedavis.marracat
# Optional website Services ID; keep empty until its web callback is configured.
AUTH_APPLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=/etc/marracat/apple-signin.p8
# Shopify Headless channel. Keep the private token in the server env only.
SHOPIFY_STORE_DOMAIN=kercqa-hi.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2026-07
