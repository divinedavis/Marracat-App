#!/usr/bin/env python3
"""Exit 0 only if <file>.sig is the catalog key's signature over <file>.

    marracat-verify-sig <file> [<file> ...]

Runs ON 167.71 as root, from marracat-catalog-swap and
marracat-catalog-deltas, before an uploaded catalog or delta goes live.
Until 2026-11-12 the swap only checked that a .sig was under 100 bytes, so
whoever held the refresh droplet's upload key could put any catalog on
marracat.com; phones would refuse it (they check the signature themselves),
but the website would serve it. The public key is root's copy,
/etc/marracat-pub/catalog-signing.pub, the one built into the app
(scripts/catalog-signing.pub).
"""
import base64
import os
import sys
from pathlib import Path

PUBLIC = Path(os.environ.get("MARRACAT_CATALOG_PUB", "/etc/marracat-pub/catalog-signing.pub"))


def main(files):
    if not files:
        sys.exit(__doc__)
    from cryptography.exceptions import InvalidSignature
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey
    public = Ed25519PublicKey.from_public_bytes(base64.b64decode(PUBLIC.read_text().strip()))
    for f in files:
        sig_file = Path(f + ".sig")
        try:
            if sig_file.is_symlink() or Path(f).is_symlink() or sig_file.stat().st_size > 100:
                raise ValueError("not a signature file")
            public.verify(base64.b64decode(sig_file.read_text().strip(), validate=True), Path(f).read_bytes())
        except (InvalidSignature, ValueError, OSError) as e:
            sys.exit(f"{f}: signature does not check out ({type(e).__name__})")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
