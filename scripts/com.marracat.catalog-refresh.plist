<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac's nightly photo + AI steps (scripts/refresh_ml.sh), 01:30.
     The rest of the catalog refresh runs every 6 hours on the marracat-refresh
     droplet (refresh-server/README.md). Until 2026-10-12 this label ran the
     whole refresh at 06:00 and 18:00.
     Install:   cp scripts/com.marracat.catalog-refresh.plist ~/Library/LaunchAgents/ &&
                launchctl bootout gui/$(id -u)/com.marracat.catalog-refresh 2>/dev/null;
                launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.marracat.catalog-refresh.plist
     Run now:   launchctl kickstart gui/$(id -u)/com.marracat.catalog-refresh -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.marracat.catalog-refresh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>/Users/divinedavis/projects/Marracat/scripts/refresh_ml.sh &gt;&gt; /Users/divinedavis/projects/Marracat/build/catalog-refresh.log 2&gt;&amp;1</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>1</integer><key>Minute</key><integer>30</integer></dict>
    <key>ProcessType</key><string>Background</string>
    <key>LowPriorityIO</key><true/>
    <key>Nice</key><integer>10</integer>
</dict>
</plist>
